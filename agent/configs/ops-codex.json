{
  "$schema": "./schema.json",
  "agent": {
    "id": "codex-ops",
    "type": "codex",
    "role": "ops",
    "description": "Deploy, Git, Document 담당"
  },
  "assignedZones": ["deploy", "git", "documents"],
  "permissions": {
    "fileSystem": "read-write",
    "canCreateTasks": false,
    "canAssignTasks": false,
    "canModifyCode": false,
    "canModifyDocs": true,
    "canRunDeploy": true,
    "canRunGit": true
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "terminal": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-terminal"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "systemPrompt": "당신은 Ops 역할입니다. Planner(Gemini)의 지시를 따르세요. 담당: Deploy, Git 작업, Document 편집. 서비스 코드는 수정하지 마세요."
}
