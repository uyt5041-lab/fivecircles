{
  "$schema": "./schema.json",
  "agent": {
    "id": "claude-coder",
    "type": "claude",
    "role": "coder",
    "description": "팀원C 서비스 코드 구현 담당"
  },
  "assignedZones": ["event-service", "spoiler-policy-service", "qa-service"],
  "permissions": {
    "fileSystem": "read-write",
    "canCreateTasks": false,
    "canAssignTasks": false,
    "canModifyCode": true
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "terminal": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-terminal"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "systemPrompt": "당신은 Coder 역할입니다. Planner(Gemini)의 지시를 따르세요. 담당: event-service, spoiler-policy-service, qa-service. 작업 시작 전 sync.md와 queue.json을 확인하세요."
}
