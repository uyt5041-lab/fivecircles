@prefix ns: <https://nospoiler.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns:PredicateSemanticInheritanceDraft a owl:Ontology ;
  rdfs:label "Predicate Semantic Inheritance Draft"@en ;
  rdfs:comment "Predicate group/member semantic lane draft generated from predicate_inheritance.json"@en .

ns:PredicateSemanticGroup a owl:Class ;
  rdfs:label "Predicate Semantic Group"@en .

ns:PredicateSemanticMember a owl:Class ;
  rdfs:label "Predicate Semantic Member"@en .

ns:hasPredicateMember a owl:ObjectProperty ;
  rdfs:domain ns:PredicateSemanticGroup ;
  rdfs:range ns:PredicateSemanticMember .

ns:impliesPredicateGroup a owl:ObjectProperty ;
  rdfs:domain ns:PredicateSemanticGroup ;
  rdfs:range ns:PredicateSemanticGroup .

ns:memberKind a owl:DatatypeProperty ;
  rdfs:domain ns:PredicateSemanticMember ;
  rdfs:range xsd:string .

ns:valueCode a owl:DatatypeProperty ;
  rdfs:domain ns:PredicateSemanticMember ;
  rdfs:range xsd:string .

ns:predicateSemanticCode a owl:DatatypeProperty ;
  rdfs:domain ns:PredicateSemanticGroup ;
  rdfs:range xsd:string .

ns:p_semantic_predicate a ns:PredicateSemanticGroup ;
  rdfs:label "P_SEMANTIC_PREDICATE"@en ;
  ns:predicateSemanticCode "P_SEMANTIC_PREDICATE" .

ns:pg_affiliation_change a ns:PredicateSemanticGroup ;
  rdfs:label "Affiliation Change" ;
  ns:predicateSemanticCode "AFFILIATION_CHANGE" ;
  ns:impliesPredicateGroup ns:p_semantic_predicate ;
  ns:hasPredicateMember ns:pm_pc_joins ;
  ns:hasPredicateMember ns:pm_pc_leaves ;
  ns:hasPredicateMember ns:pm_ps_affiliation_change .

ns:pg_death_exit a ns:PredicateSemanticGroup ;
  rdfs:label "Death/Exit" ;
  ns:predicateSemanticCode "DEATH_EXIT" ;
  ns:impliesPredicateGroup ns:p_semantic_predicate ;
  ns:hasPredicateMember ns:pm_pc_dies ;
  ns:hasPredicateMember ns:pm_pc_leaves ;
  ns:hasPredicateMember ns:pm_ps_death ;
  ns:hasPredicateMember ns:pm_ps_exit ;
  ns:hasPredicateMember ns:pm_ps_death_exit .

ns:pg_battle a ns:PredicateSemanticGroup ;
  rdfs:label "Battle" ;
  ns:predicateSemanticCode "BATTLE" ;
  ns:impliesPredicateGroup ns:p_semantic_predicate ;
  ns:impliesPredicateGroup ns:pg_adversary ;
  ns:hasPredicateMember ns:pm_pc_attacks ;
  ns:hasPredicateMember ns:pm_pc_defeats ;
  ns:hasPredicateMember ns:pm_pc_kills ;
  ns:hasPredicateMember ns:pm_ps_battle ;
  ns:hasPredicateMember ns:pm_ps_confronts .

ns:pg_adversary a ns:PredicateSemanticGroup ;
  rdfs:label "Adversary" ;
  ns:predicateSemanticCode "ADVERSARY" ;
  ns:impliesPredicateGroup ns:p_semantic_predicate ;
  ns:impliesPredicateGroup ns:pg_death_exit ;
  ns:hasPredicateMember ns:pm_pc_captures ;
  ns:hasPredicateMember ns:pm_pc_betrays ;
  ns:hasPredicateMember ns:pm_ps_threat ;
  ns:hasPredicateMember ns:pm_ps_threatens ;
  ns:hasPredicateMember ns:pm_ps_threatened ;
  ns:hasPredicateMember ns:pm_ps_intimidates ;
  ns:hasPredicateMember ns:pm_ps_coerces ;
  ns:hasPredicateMember ns:pm_ps_blackmail ;
  ns:hasPredicateMember ns:pm_ps_manipulates ;
  ns:hasPredicateMember ns:pm_ps_seizes_control ;
  ns:hasPredicateMember ns:pm_ps_dominates ;
  ns:hasPredicateMember ns:pm_ps_power_shift ;
  ns:hasPredicateMember ns:pm_ps_trust_collapse ;
  ns:hasPredicateMember ns:pm_ps_relationship_damage .

ns:pg_ally a ns:PredicateSemanticGroup ;
  rdfs:label "Ally" ;
  ns:predicateSemanticCode "ALLY" ;
  ns:impliesPredicateGroup ns:p_semantic_predicate ;
  ns:hasPredicateMember ns:pm_pc_allies_with ;
  ns:hasPredicateMember ns:pm_pc_joins ;
  ns:hasPredicateMember ns:pm_ps_ally ;
  ns:hasPredicateMember ns:pm_ps_allies_with ;
  ns:hasPredicateMember ns:pm_ps_affiliation_change ;
  ns:hasPredicateMember ns:pm_ps_partners_with ;
  ns:hasPredicateMember ns:pm_ps_co_conspirator ;
  ns:hasPredicateMember ns:pm_ps_supply_contract ;
  ns:hasPredicateMember ns:pm_ps_recurring_deal .

